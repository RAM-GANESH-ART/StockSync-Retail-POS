datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("CASHIER") // "ADMIN" or "CASHIER"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id            String     @id @default(cuid())
  name          String
  sku           String     @unique
  barcode       String     @unique
  price         Float
  costPrice     Float
  stock         Int        @default(0)
  minStockAlert Int        @default(5)
  image         String?
  categoryId    String
  category      Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  saleItems     SaleItem[]

  @@index([categoryId])
}

model Sale {
  id             String     @id @default(cuid())
  saleNumber     String     @unique
  subtotal       Float
  taxAmount      Float
  discountAmount Float      @default(0)
  totalAmount    Float
  paymentMethod  String     // "CASH", "CARD", "UPI"
  paymentStatus  String     @default("COMPLETED")
  cashierId      String
  cashier        User       @relation(fields: [cashierId], references: [id])
  createdAt      DateTime   @default(now())
  items          SaleItem[]

  @@index([createdAt])
  @@index([cashierId])
}

model SaleItem {
  id         String   @id @default(cuid())
  saleId     String
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Float
  totalPrice Float

  @@index([saleId])
  @@index([productId])
}
