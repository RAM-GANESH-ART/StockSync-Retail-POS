# -------------------------------------------------------------
# StockSync Retail POS - Environment Configuration
# -------------------------------------------------------------

# PostgreSQL Database Connection URL
# 1. Neon Serverless PostgreSQL (Recommended - neon.tech):
# Copy the pooled connection string from your Neon dashboard:
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Supabase PostgreSQL (supabase.com):
# DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 3. Local Docker PostgreSQL (via docker-compose.yml):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stocksync_pos?schema=public"

# NextAuth Authentication Security
NEXTAUTH_SECRET="stocksync_super_secret_session_key_2026"
NEXTAUTH_URL="http://localhost:3000"

# Store POS Counter Configuration
COUNTER_UPI_ID="stocksync@upi"
STORE_NAME="StockSync Retail Flagship"
STORE_TAX_RATE="5"
